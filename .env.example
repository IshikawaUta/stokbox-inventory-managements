# MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/inventaris?retryWrites=true&w=majority
MONGO_DB_NAME=inventaris

# Cloudinary
# Prioritas: CLOUDINARY_URL (format: cloudinary://KEY:SECRET@CLOUD_NAME).
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_FOLDER=inventaris

# Application
APP_NAME=InventarisKu
APP_SECRET_KEY=please-change-this-to-a-random-secret
APP_ENV=development

# CORS Origins (comma-separated, default: *)
CORS_ORIGINS=*

# Session Cookie (set ke 1 hanya jika server pakai HTTPS)
SESSION_COOKIE_SECURE=0

# Fenrir v4.3.2 - Dev Mode (Laravel-style debug page)
FENRIR_DEV_MODE=0

# Fenrir v4.3.2 - Monitoring Dashboard
MONITORING_ENABLED=false
MONITORING_USER=admin
MONITORING_PASSWORD=changeme
MONITORING_SECRET_KEY=please-change-this-to-a-random-secret
